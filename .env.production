# Production build (Vercel). Same-origin /api: vercel.json rewrites it to the flightmode-api server
# (http://159.89.82.25/api) — the browser stays on https, so no mixed content and no CORS.
VITE_API_URL=/api/v1

# Live updates between counters: Reverb is not reachable on the production server yet — off.
# Set the key (= API REVERB_APP_KEY) and host / port / scheme once Reverb is exposed over wss.
VITE_REVERB_APP_KEY=
