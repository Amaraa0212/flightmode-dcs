# Production build (Vercel). Same-origin /api: vercel.json rewrites it to the flightmode-api server
# (https://api.skythium.com/api) — the browser stays on its own origin, so no CORS.
VITE_API_URL=/api/v1

# Live updates between counters: Laravel Reverb on the API server, behind nginx + TLS at wss://wss.skythium.com.
# The key is public (it is in the browser bundle) and must equal the API's REVERB_APP_KEY; the secret stays on the server.
VITE_REVERB_APP_KEY=8aeef8915851115850d46b832295e790
VITE_REVERB_HOST=wss.skythium.com
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
